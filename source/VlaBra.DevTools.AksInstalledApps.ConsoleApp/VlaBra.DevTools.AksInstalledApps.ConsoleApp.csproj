<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>aks-apps</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="TestData\Chart.yaml" />
    <None Remove="TestData\values.yaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="TestData\Chart.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="TestData\values.yaml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VlaBra.DevTools.AksInstalledApps.Lib\VlaBra.DevTools.AksInstalledApps.Lib.csproj" />
  </ItemGroup>

</Project>
